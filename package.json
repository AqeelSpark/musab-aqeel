    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "motion": "12.43.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
